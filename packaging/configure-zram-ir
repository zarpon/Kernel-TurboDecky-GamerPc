#!/bin/sh
# Configure the TurboDecky ZRAM-IR policy without ever resetting live swap.
set -eu

name="${1:-}"
case "$name" in
  zram[0-9]*) ;;
  *) exit 0 ;;
esac

# These roots make the packaged helper testable without touching the host's
# sysfs/procfs. Udev does not set either variable in normal operation.
sys_root="${TURBODECKY_SYS_ROOT:-/sys}"
proc_sys_root="${TURBODECKY_PROC_SYS_ROOT:-/proc/sys}"
sys="$sys_root/block/$name"

[ -d "$sys" ] || exit 0

log_notice() {
  if command -v logger >/dev/null 2>&1; then
    logger -t turbodecky-zram-ir -- "$*"
  fi
}

# ZRAM-IR value 1 makes every initial write try priority 0 and priority 1.
# Reassert it when zram appears in case systemd-sysctl ran before zram loaded.
if [ -w "$proc_sys_root/vm/zram_recomp_immediate" ]; then
  printf '%s\n' 1 > "$proc_sys_root/vm/zram_recomp_immediate"
fi

# The kernel does not permit changing the compressor after disksize has
# initialized a zram device. The zram-generator drop-in and systemd drop-in
# configure it before that point; this UDEV path is only a safe fallback.
if [ "$(cat "$sys/initstate" 2>/dev/null || printf 1)" != 0 ]; then
  log_notice "$name already initialized; preserving its active compressor setup"
  exit 0
fi

if [ ! -w "$sys/comp_algorithm" ] || ! grep -qw lz4kdr "$sys/comp_algorithm"; then
  log_notice "$name does not expose lz4kdr; ZRAM-IR setup skipped"
  exit 0
fi

if [ ! -w "$sys/recomp_algorithm" ] || ! grep -qw zstd "$sys/recomp_algorithm"; then
  log_notice "$name does not expose zstd recompression; ZRAM-IR setup skipped"
  exit 0
fi

printf '%s\n' lz4kdr > "$sys/comp_algorithm"
printf '%s\n' 'algo=zstd priority=1' > "$sys/recomp_algorithm"

# Sysfs shows the selected algorithm in brackets. Accept direct write forms
# too, so the exact helper can be validated against regular files in CI.
is_selected() {
  algorithm="$1"
  path="$2"
  grep -Eq "(^|[[:space:]])\\[${algorithm}\\]([[:space:]]|$)|(^|[[:space:]])algo=${algorithm}([[:space:]]|$)|^${algorithm}$" "$path"
}

is_selected lz4kdr "$sys/comp_algorithm"
is_selected zstd "$sys/recomp_algorithm"

log_notice "$name configured for ZRAM-IR: lz4kdr priority 0 -> zstd priority 1"
