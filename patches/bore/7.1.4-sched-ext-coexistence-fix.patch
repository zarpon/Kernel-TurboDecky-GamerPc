From 75b25599458bfc072d9f0ae54c9436363dd5201c Mon Sep 17 00:00:00 2001
From: Codex Validation <noreply@localhost>
Date: Thu, 23 Jul 2026 13:26:45 -0500
Subject: [PATCH] sched: port 0002 sched-ext coexistence fix to Linux 7.1.4

Keep the upstream reweight_task() compatibility entry point separate from the
BORE port.  On Linux 7.3, preserve the upstream helper's complete load-weight
update semantics through reweight_task_fair(), which updates both the raw
entity/PELT state and the split EEVDF hierarchical load state.

Upstream-sha256: cdf138cdb94fcb4e2988bd7d2873a51522fdb7212ec314fde202facaf8210b5c
---
 include/linux/sched/bore.h |  1 +
 kernel/sched/fair.c        | 12 ++++++++++++
 2 files changed, 13 insertions(+)

diff --git a/include/linux/sched/bore.h b/include/linux/sched/bore.h
index 92bebc114e..a5b8e6f1d2 100644
--- a/include/linux/sched/bore.h
+++ b/include/linux/sched/bore.h
@@ -45,6 +45,7 @@ extern int  sched_burst_protect_slice_lv_update_handler(const struct ctl_table *
  * both halves consistent, so BORE drives that instead.
  */
+extern void reweight_task(struct task_struct *p, int prio);
 extern void reweight_task_fair(struct rq *rq, struct task_struct *p,
 			       const struct load_weight *lw);
 
 #endif /* _KERNEL_SCHED_BORE_H */
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index ed51ce22d..63d2a6cd8 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -14439,3 +14439,15 @@ __init void init_sched_fair_class(void)
 	zalloc_cpumask_var(&nohz.idle_cpus_mask, GFP_NOWAIT);
 #endif
 }
+
+#ifdef CONFIG_SCHED_BORE
+void reweight_task(struct task_struct *p, int prio)
+{
+	struct load_weight lw = {
+		.weight = scale_load(sched_prio_to_weight[prio]),
+		.inv_weight = sched_prio_to_wmult[prio],
+	};
+
+	reweight_task_fair(task_rq(p), p, &lw);
+}
+#endif /* CONFIG_SCHED_BORE */
-- 
2.51.1
