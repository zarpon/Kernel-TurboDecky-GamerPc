# Zarpon upstream Linux configuration overrides for generic amd64 systems.
# The main branch follows the latest stable kernel.org source while retaining
# the performance policy and multimedia/gaming-oriented patch configuration.

# Keep the x86-64 CPU vendor matrix broad; do not cap CPUs for one machine.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_CPU_SUP_HYGON=y
CONFIG_CPU_SUP_CENTAUR=y
CONFIG_CPU_SUP_ZHAOXIN=y
CONFIG_GENERIC_CPU=y
CONFIG_MICROCODE=y
CONFIG_X86_MCE=y
# CONFIG_X86_NATIVE_CPU is not set

# BORE is selected from the exact current upstream Linux-series patch lock.
# CONFIG_SCHED_ALT is not set
# CONFIG_SCHED_PDS is not set
# CONFIG_SCHED_BMQ is not set
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

# Enable the Zen kernel interactive tuning profile built into the patch stack.
CONFIG_ZEN_INTERACTIVE=y

CONFIG_SCHED_POC_SELECTOR=y
CONFIG_CPU_IDLE_GOV_NAP=y

# MULTIPLEXER is boolean in current kernels; never carry the stale module value.
CONFIG_MULTIPLEXER=y

# REFLEX is built in and selected by the CPUFreq default-governor choice.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_REFLEX=y
CONFIG_CPU_FREQ_DEFAULT_GOV_REFLEX=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
# REFLEX needs the vendor P-State drivers in passive mode so it owns the
# frequency policy instead of amd-pstate active/guided internal control.
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=2
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set

CONFIG_LRU_MARIE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y

CONFIG_ZRAM=m
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# VirtualBox host support. Its vboxdrv, vboxnetflt and vboxnetadp drivers are
# external modules, while KVM must remain available without reserving VT-x/AMD-V
# as soon as kvm_intel or kvm_amd is loaded.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_NETFILTER=y

CONFIG_CPU_MITIGATIONS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="audit=0 split_lock_detect=off mitigations=off nowatchdog intel_pstate=passive amd_pstate=passive cpuidle.governor=nap kvm.enable_virt_at_load=0"
# CONFIG_CMDLINE_OVERRIDE is not set

# Clang/LLVM ThinLTO with the generic x86-64 CPU choice; never use
# -march=native from the runner.
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y

# Hosted package builds omit DWARF/BTF but retain modules, headers and kallsyms.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set

# Kbuild receives KERNELRELEASE=<version>.turbodecky directly.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
