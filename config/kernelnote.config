# Zarpon upstream Linux configuration overrides for HP 240 G4 / LMDE
# The generic branch uses upstream stable Linux 7.1.3 while retaining the
# performance policy and patch configuration from the TurboLQX branch.

# Fixed CPU target: Intel Core i3-5005U Broadwell-U, 2 cores / 4 threads.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_CPU_SUP_INTEL=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y
# CONFIG_MICROCODE_AMD is not set
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
# CONFIG_X86_MCE_AMD is not set
# CONFIG_NUMA is not set
# CONFIG_X86_5LEVEL is not set
# CONFIG_MAXSMP is not set
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_X86_VSMP is not set
# CONFIG_X86_UV is not set
# CONFIG_X86_GOLDFISH is not set
# CONFIG_X86_INTEL_MID is not set

# BORE operates on upstream CFS/EEVDF.
# CONFIG_SCHED_ALT is not set
# CONFIG_SCHED_PDS is not set
# CONFIG_SCHED_BMQ is not set
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

CONFIG_SCHED_POC_SELECTOR=y
CONFIG_CPU_IDLE_GOV_NAP=y

# REFLEX is built in and selected by the CPUFreq default-governor choice.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_REFLEX=y
CONFIG_CPU_FREQ_DEFAULT_GOV_REFLEX=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set

CONFIG_LRU_MARIE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y

CONFIG_ZRAM=m
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

CONFIG_CPU_MITIGATIONS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="audit=0 intel_pstate=disable amd_pstate=disable split_lock_detect=off mitigations=off nowatchdog cpuidle.governor=nap"
# CONFIG_CMDLINE_OVERRIDE is not set

# Clang/LLVM ThinLTO; -mtune=broadwell is passed without -march=native.
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y

# Hosted package builds omit DWARF/BTF but retain modules, headers and kallsyms.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set

# Kbuild receives KERNELRELEASE=linux.7.1.3.zarpon.r1 directly.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
