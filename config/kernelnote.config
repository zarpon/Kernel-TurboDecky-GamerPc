# Kernelnote configuration overrides for HP 240 G4 / LMDE
# Keep the Liquorix tuning base but use upstream CFS/EEVDF so BORE is effective.
# CONFIG_SCHED_ALT is not set
# CONFIG_SCHED_PDS is not set
# CONFIG_SCHED_BMQ is not set
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=2000000

# POC Selector accelerates idle-CPU selection without replacing CFS/EEVDF.
CONFIG_SCHED_POC_SELECTOR=y

# NAP is the selected CPUIdle governor. The boot argument is embedded below.
CONFIG_CPU_IDLE_GOV_NAP=y

# Marie LRU is compiled in and enabled by default at boot.
CONFIG_LRU_MARIE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# ADIOS is built in and selected as the kernel default MQ scheduler.
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y

# ZRAM-IR requires multi-compressor support. LZ4 is the compile-time primary
# default; the tuning package registers ZSTD as priority 1 before disksize.
CONFIG_ZRAM=m
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# Keep mitigation support compiled so mitigations=off is recognized. The
# built-in command line extends, rather than replaces, bootloader arguments.
CONFIG_CPU_MITIGATIONS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="audit=0 intel_pstate=disable amd_pstate=disable split_lock_detect=off mitigations=off nowatchdog cpuidle.governor=nap"
# CONFIG_CMDLINE_OVERRIDE is not set

# The final kernel must be built by Clang/LLVM using ThinLTO.
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y

# Hosted package builds intentionally omit DWARF/BTF debug data. Kernel image,
# modules, headers, kallsyms and runtime functionality remain available.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set

# Generic AMD64 notebook package settings.
CONFIG_LOCALVERSION="-kernelnote-lqx-marie-bore-poc-nap-adios-zramir-thinlto"
# CONFIG_LOCALVERSION_AUTO is not set
